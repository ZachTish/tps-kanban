{
  "name": "tps-kanban",
  "version": "0.1.7",
  "description": "TPS Kanban (Dev) - simple kanban plugin",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test scripts/test-tps-contracts.mjs && node --test scripts/test-base-filter-composition.mjs && node --test scripts/test-kanban-utils.mjs && npm run test:settings && npm run build",
    "test:settings": "node --test scripts/test-settings-contract.mjs"
  },
  "devDependencies": {
    "builtin-modules": "3.3.0",
    "esbuild": "^0.19.3",
    "obsidian": "latest",
    "typescript": "~5.3.0"
  }
}
